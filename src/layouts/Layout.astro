---
import HeadSeo from '../components/meta/HeadSeo.astro';

const { title, description, image, article } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<HeadSeo title={title} description={description} image={image} article={article} />
	</head>
	<body>
		
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
