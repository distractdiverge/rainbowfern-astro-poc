---
const { links } = Astro.props;
---

<div id="mobile-nav" data-is-open={String(false)} class="relative">
    <button
        id="navToggle"
        class="md:hidden z-50 relative mt-2 mr-2 w-6 h-6 flex flex-col justify-between"
    >
        <span
            data-active-class="rotate-45 translate-y-2"
            class="h-1 block w-full bg-gray-800 transform transition-all duration-300 origin-center"
        ></span>
        <span
            x-active-class="opacity-0"
            class="h-1 block w-full bg-gray-800 transform transition-all duration-300"
        ></span>
        <span
            x-active-class="-rotate-45 -translate-y-3"
            class="h-1 blockw-full bg-gray-800 transform transition-all duration-300 origin-center"
        ></span>
    </button>
    <nav
        class={`
          fixed top-0 left-0 w-full h-screen bg-white opacity-90 backdrop-blur-md z-40
          transform transition-transform duration-300 ease-in-out
          md:hidden flex flex-col items-center justify-center space-y-6
      `}
        data-active-class="translate-x-0"
        data-inactive-class="translate-x-full"
    >
        {links.map(({ title, to }: { title: string; to: string }) => (
            <a
                href={to}
                class="text-2xl md:text-base block px-1 py-3 md:px-2 hover:text-gray-400 hover:underline"
            >
                {title}
            </a>
        ))}
        <a
            class="text-2xl md:text-base block px-1 py-3 md:px-2 hover:text-gray-400 hover:underline"
            href="/contact"
        >
            Contact
        </a>
    </nav>
</div>

<script>
    import { Picture } from "astro:assets";

    const toggleButton =
        document.querySelector<HTMLElement>("button#navToggle");
    const navPanel = document.querySelector("nav");
    const getIsOpen = () => {
        const mobileNav = document.querySelector("#mobile-nav[data-is-open]");
        return mobileNav?.dataset.isOpen === "true";
    };
    const setIsOpen = (value: boolean) => {
        const mobileNavContainer = document.querySelector(
            "#mobile-nav",
        ) as HTMLElement;

        if (!mobileNavContainer) {
            console.error("Can't find Mobile nav");
        } else {
            mobileNavContainer.dataset.isOpen = String(value);
            updateNav(value);
        }
    };
    const updateNav = (isOpen: boolean) => {
        const mobileNav = document.querySelector(
            "#mobile-nav > nav",
        ) as HTMLElement;

        if (!mobileNav) {
            console.log("Error, can't find mobile nav");
        } else {
            const activeClassName = mobileNav.dataset.activeClass!;
            const inactiveClassName = mobileNav.dataset.inactiveClass!;

            if (isOpen) {
                mobileNav.classList.remove(inactiveClassName);
                mobileNav.classList.add(activeClassName);
            } else {
                mobileNav.classList.remove(activeClassName);
                mobileNav.classList.add(inactiveClassName);
            }
        }
    };

    const updateSpanClasses = () => {
        const toggleButtonSpans = document.querySelectorAll<HTMLElement>(
            "button#navToggle > span",
        );

        toggleButtonSpans.forEach((aSpan) => {
            const activeClassName: string = aSpan.dataset.activeClass!;
            if (getIsOpen()) {
                aSpan.classList.add(activeClassName);
            } else {
                aSpan.classList.remove(activeClassName);
            }
        });
    };

    if (!toggleButton) {
        console.error("Can't find the toggle button or spans inside it.");
    } else {
        toggleButton.addEventListener("click", () => {
            setIsOpen(true);
            updateSpanClasses();
        });
    }

    if (!navPanel) {
        console.error("Can't find the nav panel.");
    } else {
        navPanel.addEventListener("click", () => {
            setIsOpen(false);
            updateSpanClasses();
        });
    }
</script>
