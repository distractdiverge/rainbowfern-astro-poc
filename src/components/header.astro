---
import { Image } from "astro:assets";
import rainbowFernLogo from "../assets/fern-colors-web.svg";
import MobileNav from "../components/mobile_nav.astro";
import DesktopNav from "../components/desktop_nav.astro";
const navigationLinks = [
    {
        title: "About",
        to: "/",
    },
    {
        title: "Projects",
        to: "/projects",
    },
    {
        title: "Experience",
        to: "/experience",
    },
    {
        title: "Education",
        to: "/education",
    },
];
---

<header class="bg-white flex justify-between p-1 md:p-4">
    <a href="/#" class="flex">
        <Image
            src={rainbowFernLogo}
            alt="Rainbowfern logo"
            class="block mt-2 ml-1 mr-2 md:mt-0 md:ml-0 max-w-[20px] max-h-[20px] md:max-w-[32px] md:max-h-[32px]"
        />

        <h1 class="block mt-2 mr-2 text-s md:text-base">Rainbowfern.com</h1>
    </a>
    <div>
        <MobileNav links={navigationLinks} />
    </div>
    <DesktopNav class="hidden md:flex" links={navigationLinks} />
</header>
